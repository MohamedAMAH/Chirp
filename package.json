{
  "name": "chirp-dictation",
  "private": true,
  "version": "0.1.0",
  "description": "Offline Windows push-to-talk dictation",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.cjs",
    "models": "node scripts/models.mjs",
    "native": "scripts\\native.cmd",
    "start": "npm run build && npm run native && electron .",
    "dist": "npm run models && npm run native && npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.12.36"
  },
  "author": "Chirp"
}
